; Engine configuration file.
; Founders Valley / Open Rails — V1 sandbox.

config_version=5

[application]

config/name="Open Rails"
config/description="Open-source railroad management sandbox inspired by classic Railroad Tycoon games."
config/version="0.1.0"
# The valley is reached through the menu: the menu is where a save is found
# and a company named.  `Game.tscn` still boots on its own — with no pending
# sandbox intent it opens the shipped map under the content default name.
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7")

[debug]

settings/gdscript/max_output_lines_extended=40

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

